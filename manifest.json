{
  "manifest_version": 3,
  "name": "Pinterest Media Downloader",
  "version": "1.0.0",
  "description": "Download Pinterest videos, GIFs and images with auto-scroll. Files are named after your search query.",
  "permissions": ["downloads", "storage", "activeTab", "scripting"],
  "host_permissions": [
    "*://*.pinterest.com/*",
    "*://*.pinterest.ca/*",
    "*://*.pinterest.co.uk/*",
    "*://*.pinterest.fr/*",
    "*://*.pinterest.de/*",
    "*://*.pinterest.es/*",
    "*://*.pinterest.it/*",
    "*://*.pinterest.com.au/*",
    "*://*.pinterest.jp/*",
    "*://*.pinimg.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pinterest Media Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.pinterest.com/*",
        "*://*.pinterest.ca/*",
        "*://*.pinterest.co.uk/*",
        "*://*.pinterest.fr/*",
        "*://*.pinterest.de/*",
        "*://*.pinterest.es/*",
        "*://*.pinterest.it/*",
        "*://*.pinterest.com.au/*",
        "*://*.pinterest.jp/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
